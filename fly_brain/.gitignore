# raw male-CNS v1.0 downloads (~1.1 GB, public at male-cns.janelia.org/download)
# (anchored, so app/public/data and dashboard/data are still tracked)
/data/

# rebuilt by `python build_brain.py` (brain.npz is 198 MB, over GitHub's 100 MB limit)
brain.npz
brain_meta.parquet

# large simulation outputs; small JSON summaries are kept
results/*.parquet
results/bar_rates/

# dashboard: raw activity from export_dashboard.py; pack_dashboard.py turns it into the PNG/JS the page loads
dashboard/data/*.bin

# web app: dependencies/build output; web_data/ is rebuilt by export_brain_cloud.py
app/node_modules/
app/dist/
web_data/
ui/rates/

__pycache__/
*.pyc
.venv/
.vscode/

# third-party 3D models (copyrighted, private use only; see bike/README.md)
assets/*.glb
results/*_brain.npz
